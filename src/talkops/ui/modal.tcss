/* Modal dialog container and screen */

OpsModalScreen {
    align: center middle;
    background: $background 70%;
}

/* Content-hugging is the safe default. */
ModalDialog,
.ops-modal-dialog {
    width: 88;
    max-width: 95%;
    height: auto;
    max-height: 85vh;
    min-height: 12;
    background: $surface;
    border: round $primary 70%;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    border-subtitle-align: center;
    padding: 1 2;
}

/* Browsers and managers with a scrolling body. */
ModalDialog.-workspace,
.ops-modal-dialog.-workspace {
    width: 104;
    max-width: 95%;
    height: 85vh;
    max-height: 90vh;
}

/* Small prompts, settings, and short option lists. */
ModalDialog.-compact,
.ops-modal-dialog.-compact {
    width: 64;
    max-width: 95%;
    height: auto;
    max-height: 85vh;
    min-height: 8;
}

/* Header container (optional) */
.ops-modal-header {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

/* ── Pill Tabs ─────────────────────────────────────────── */

PillTabs {
    height: auto;
    width: 100%;
    layout: horizontal;
    margin-bottom: 1;
}

PillTab {
    width: auto;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin-right: 1;
    color: $text-muted;
    background: transparent;
    text-align: center;
}

PillTab:hover {
    color: $foreground;
    background: $surface-lighten-1;
}

PillTab.pill-tab--active {
    background: $primary 18%;
    color: $foreground;
    text-style: bold;
    border-left: wide $primary;
}

/* ── Modal Search Input ─────────────────────────────────── */

ModalSearchInput {
    height: auto;
    width: 100%;
    layout: horizontal;
    margin-bottom: 1;
    background: $panel 45%;
    border-bottom: solid $primary 35%;
}

ModalSearchInput:focus-within {
    background: $panel 70%;
    border-bottom: solid $primary;
}

ModalSearchInput .modal-search-icon {
    width: 3;
    height: 1;
    color: $text-muted;
    padding-left: 1;
}

ModalSearchInput:focus-within .modal-search-icon {
    color: $primary;
}

ModalSearchInput Input {
    width: 1fr;
    height: 1;
    background: transparent;
    border: none;
    padding: 0;
}

ModalSearchInput Input:focus {
    background: transparent;
    border: none;
    background-tint: transparent;
}

/* ── Scrollable Body & Pinned Action Footer ────────────── */

ModalBodyScroll,
.ops-modal-body-scroll {
    height: auto;
    max-height: 6;
    width: 100%;
    margin-bottom: 1;
    background: transparent;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

ModalBodyScroll.ops-modal-body--notice,
.ops-modal-body-scroll.ops-modal-body--notice {
    height: auto;
    max-height: 55vh;
    margin-bottom: 0;
}

ModalBodyScroll.ops-modal-body--fill,
.ops-modal-body-scroll.ops-modal-body--fill,
OpsModalScreen.-split-detail ModalBodyScroll,
OpsModalScreen.-split-detail .ops-modal-body-scroll {
    height: 1fr;
    min-height: 3;
    max-height: 100%;
    padding-right: 1;
    overflow-y: auto;
}

ModalFooter,
.ops-modal-footer {
    height: auto;
    width: 100%;
    background: transparent;
}

/* ── OptionList inside ModalScreen ─────────────────────── */

/* Lists hug content unless a screen opts into workspace behavior. */
OpsModalScreen OptionList {
    height: auto;
    background: transparent;
    background-tint: transparent;
    border: none;
    padding: 0;
    scrollbar-gutter: stable;
}

OpsModalScreen .ops-modal-dialog.-workspace OptionList {
    height: 1fr;
}

/* In split-detail mode, workspace OptionLists pin at the bottom as an action menu
   while ModalBodyScroll absorbs variable-length detail content above. */
OpsModalScreen.-split-detail .ops-modal-dialog.-workspace OptionList,
OpsModalScreen.-split-detail OptionList.ops-modal-actions {
    height: auto;
    min-height: 4;
    max-height: 10;
    border-top: solid $primary 35%;
    padding-top: 1;
    background: transparent;
}

OpsModalScreen OptionList:focus {
    border: none;
    background: transparent;
    background-tint: transparent;
}

OpsModalScreen OptionList > .option-list--option-highlighted,
OpsModalScreen OptionList:focus > .option-list--option-highlighted {
    background: $primary 15%;
    color: $foreground;
    text-style: none;
}

/* ── Select & SelectOverlay inside ModalScreen ─────────── */

OpsModalScreen SelectOverlay,
OpsModalScreen .ops-modal-dialog.-workspace SelectOverlay {
    height: auto;
    max-height: 12;
    border: solid $primary;
    background: $surface;
    padding: 0 1;
    overflow-x: hidden;
}

OpsModalScreen SelectOverlay:focus,
OpsModalScreen .ops-modal-dialog.-workspace SelectOverlay:focus {
    border: solid $primary;
}

OpsModalScreen SelectOverlay > .option-list--option-highlighted,
OpsModalScreen SelectOverlay:focus > .option-list--option-highlighted {
    background: $primary 35%;
    color: $foreground;
    text-style: bold;
}

